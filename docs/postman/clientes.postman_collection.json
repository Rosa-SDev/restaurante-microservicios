{
  "info": {
    "name": "Restaurante · clientes-service",
    "description": "Clientes y reservas, consumidos a través del api-gateway. Variable base = http://localhost:8080 (Compose) o http://localhost:30080 (Kubernetes). Ejecutar con el Collection Runner, en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenMesero",
      "value": ""
    },
    {
      "key": "documento",
      "value": ""
    },
    {
      "key": "fechaFutura",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    },
    {
      "key": "reservaMeseroId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · Autenticación",
      "item": [
        {
          "name": "Login · administrador (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const token = pm.response.json().token;",
                  "pm.collectionVariables.set(\"token\", token);",
                  "if (pm.environment.name) { pm.environment.set(\"token\", token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"administrador@restaurante.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Guarda el token en la variable {{token}}."
          }
        },
        {
