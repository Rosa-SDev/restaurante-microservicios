        {
          "name": "POST · crear cliente (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Documento distinto en cada ejecución, para no chocar con el 409 de documento repetido.",
                  "pm.collectionVariables.set(\"documento\", String(Date.now()).slice(-10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => {",
                  "    pm.response.to.have.status(201);",
