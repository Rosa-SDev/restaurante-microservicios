    {
      "name": "3 · Reservas",
      "item": [
        {
          "name": "POST · crear reserva (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha dentro de 2 días a las 19:00, en formato LocalDateTime (sin zona).",
                  "const d = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);",
                  "const p = n => String(n).padStart(2, \"0\");",
                  "pm.collectionVariables.set(\"fechaFutura\", `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T19:00:00`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Queda en estado PENDIENTE\", () => {",
                  "    pm.expect(pm.response.json().estado).to.eql(\"PENDIENTE\");",
                  "});",
                  "pm.collectionVariables.set(\"reservaId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/reservas",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaHora\": \"{{fechaFutura}}\",\n  \"numPersonas\": 4,\n  \"clienteId\": {{clienteId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarda el id en {{reservaId}}."
          }
        },
